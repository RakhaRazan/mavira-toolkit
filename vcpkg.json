{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "mavira",
  "version-string": "0.1.0",
  "description": "MAVIRA - High-performance portable Windows x64 comic, manga, and PDF library manager and GPU-accelerated reader.",
  "dependencies": [
    {
      "name": "qtbase",
      "default-features": false,
      "features": [
        "gui",
        "widgets",
        "opengl",
        "png",
        "jpeg",
        "freetype",
        "pcre2",
        "doubleconversion",
        "thread"
      ]
    },
    "libzip",
    "libarchive",
    "libjpeg-turbo",
    "libpng",
    "libwebp",
    "pdfium",
    {
      "name": "sqlite3",
      "features": [
        "fts5"
      ]
    },
    "spdlog",
    "gtest"
  ]
}
