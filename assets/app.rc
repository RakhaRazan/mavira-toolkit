#include <winver.h>

IDI_ICON1 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,1,0,0
PRODUCTVERSION  1,1,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "MAVIRA Contributors\0"
            VALUE "FileDescription",  "MAVIRA - Native Reading Experience\0"
            VALUE "FileVersion",      "1.1.0\0"
            VALUE "InternalName",     "MAVIRA\0"
            VALUE "LegalCopyright",   "Copyright (c) 2026 MAVIRA Contributors (MIT License)\0"
            VALUE "OriginalFilename", "MAVIRA.exe\0"
            VALUE "ProductName",      "MAVIRA\0"
            VALUE "ProductVersion",   "1.1.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
